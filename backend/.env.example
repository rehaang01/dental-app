# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dental" # Connection string for PostgreSQL database. Format: postgresql://user:password@host:port/database

JWT_SECRET="your_jwt_secret_key_here" # Secret key for signing JWT tokens. Use a long, random string in production.

FRONTEND_URL="http://localhost:5173" # URL of the frontend application, used for CORS and cookie settings

PORT=3001 # Port on which the backend server will run
NODE_ENV=development # development | production
