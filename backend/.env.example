# ─── Database ────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dental"  # Format: postgresql://user:password@host:port/database

# ─── Auth ─────────────────────────────────────────────────────────
JWT_SECRET="your_jwt_secret_key_here"  # Use a long random string in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development                   # development | production
FRONTEND_URL="http://localhost:5173"   # URL of the frontend (used for CORS)

# ─── WhatsApp ─────────────────────────────────────────────────────
# Set to true to enable WhatsApp messaging. When enabled, the server will
# print a QR code on first startup — scan it with the clinic's WhatsApp.
# Leave unset or set to false to disable entirely (server starts faster).
ENABLE_WHATSAPP=false