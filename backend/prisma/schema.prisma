generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Patients ────────────────────────────────────────────────────
model Patient {
  id               String   @id @default(cuid())
  patientCode      String   @unique // e.g. DEN-0001
  name             String
  gender           String
  country          String?   @default("India")
  age              Int
  dob              DateTime
  address          String
  assignedDoctor   String // "mom" | "dad"
  contactNumbers   String[] // array of phone numbers
  remarks          String?
  isActive         Boolean  @default(true)
  registrationDate DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  treatmentPlan TreatmentPlan?
  billing       Billing?
  visits        Visit[]
}

model TreatmentPlan {
  id         String   @id @default(cuid())
  patientId  String   @unique
  patient    Patient  @relation(fields: [patientId], references: [id])
  upperRight String?
  upperLeft  String?
  lowerRight String?
  lowerLeft  String?
  general    String?
  updatedAt  DateTime @updatedAt

  history TreatmentHistory[]
}

model TreatmentHistory {
  id              String        @id @default(cuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id])
  upperRight      String?
  upperLeft       String?
  lowerRight      String?
  lowerLeft       String?
  general         String?
  comment         String? // like a git commit message
  changedBy       String // doctor name
  changedAt       DateTime      @default(now())
}

model Billing {
  id             String   @id @default(cuid())
  patientId      String   @unique
  patient        Patient  @relation(fields: [patientId], references: [id])
  estimatedTotal Float    @default(0)
  totalPaid      Float    @default(0)
  balanceDue     Float    @default(0)
  updatedAt      DateTime @updatedAt

  history BillingHistory[]
}

model BillingHistory {
  id            String   @id @default(cuid())
  billingId     String
  billing       Billing  @relation(fields: [billingId], references: [id])
  prevEstimated Float
  prevPaid      Float
  prevBalance   Float
  newEstimated  Float
  newPaid       Float
  newBalance    Float
  comment       String?
  changedBy     String
  changedAt     DateTime @default(now())
}

model Visit {
  id                    String   @id @default(cuid())
  patientId             String
  patient               Patient  @relation(fields: [patientId], references: [id])
  visitDate             DateTime @default(now())
  doctor                String
  treatmentDoneToday    String?
  medicinesInstructions String?
  paymentDelta          Float    @default(0) // positive = charge, negative = payment
  includeDuesReminder   Boolean  @default(false)
  whatsappSent          Boolean  @default(false)
  whatsappError         String?
  createdAt             DateTime @default(now())
}